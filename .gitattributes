# Normalize line endings in the working tree.
* text=auto eol=lf

# Frozen topology dumps and config files are compared byte for byte
# (--dump-topology and "Copy topology" must produce identical text, usable
# unchanged as a test fixture). The serializer is configured to write "\n"
# explicitly so this holds after a fresh checkout.
*.json text eol=lf
*.jsonc text eol=lf

# Windows toolchains expect CRLF in these files.
*.sln text eol=crlf
*.csproj text eol=crlf
*.props text eol=crlf
*.targets text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf

# Never touch binary files.
*.ico binary
*.png binary
*.dll binary
*.exe binary
