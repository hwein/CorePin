<UserControl x:Class="CorePin.App.Views.CpuMapView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CorePin.App.Views"
             Focusable="False">
  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Only the clusters scroll; presets, footer and switch stay in sight. -->
    <ScrollViewer Grid.Row="0"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalAlignment="Top"
                  Focusable="False">
      <views:CpuMapControl x:Name="Map"/>
    </ScrollViewer>

    <!-- Text and button share one row: a second row would push the clusters into scrolling. -->
    <Grid x:Name="HintBlock" Grid.Row="1" Margin="0,12,0,0" Visibility="Collapsed">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <TextBlock Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center"
                 Text="This CPU isn't profiled yet — pinning works, but the groups aren't named."
                 TextWrapping="Wrap"
                 Foreground="{DynamicResource CorePin.Brush.TextSecondary}"/>
      <Button x:Name="HelpNameButton" Grid.Column="1" Content="Help us name them"
              Click="HelpNameButton_Click" VerticalAlignment="Center"
              Padding="8,0" MinWidth="{StaticResource CorePin.HitTarget.MinWidth}"
              Height="{StaticResource CorePin.HitTarget.MinHeight}"/>
    </Grid>

    <!-- Preset buttons are inserted before the toggle in code, one per cluster. -->
    <WrapPanel x:Name="PresetRow" Grid.Row="2" Margin="0,12,0,0">
      <CheckBox x:Name="SmtToggle" Content="SMT threads" Click="SmtToggle_Click"
                Margin="0,4,0,0" MinHeight="{StaticResource CorePin.HitTarget.MinHeight}"
                VerticalContentAlignment="Center"
                Visibility="Collapsed" ToolTipService.ShowOnDisabled="True"/>
    </WrapPanel>

    <!-- A notice replaces count and mask entirely until the next selection change. -->
    <Grid Grid.Row="3" Margin="0,12,0,0" MinHeight="28">
      <StackPanel x:Name="FooterCounts" Orientation="Horizontal">
        <TextBlock x:Name="CountText" VerticalAlignment="Center"
                   FontFamily="{StaticResource CorePin.Font.Mono}"
                   FontSize="{StaticResource CorePin.FontSize.Mono}"/>
        <TextBlock x:Name="MaskSeparator" Text=" · " VerticalAlignment="Center"
                   FontFamily="{StaticResource CorePin.Font.Mono}"
                   FontSize="{StaticResource CorePin.FontSize.Mono}"/>
        <Button x:Name="MaskButton" Click="MaskButton_Click"
                Padding="4,0" MinWidth="{StaticResource CorePin.HitTarget.MinWidth}"
                Height="{StaticResource CorePin.HitTarget.MinHeight}"
                FontFamily="{StaticResource CorePin.Font.Mono}"
                FontSize="{StaticResource CorePin.FontSize.Mono}"
                ToolTipService.ShowOnDisabled="True"/>
      </StackPanel>
      <TextBlock x:Name="NoticeText" VerticalAlignment="Center" Visibility="Collapsed"
                 TextTrimming="CharacterEllipsis"/>
    </Grid>

    <CheckBox x:Name="RuleEnabledToggle" Grid.Row="4" Content="Rule enabled"
              Click="RuleEnabledToggle_Click"
              Margin="0,8,0,0" MinHeight="{StaticResource CorePin.HitTarget.MinHeight}"
              VerticalContentAlignment="Center"
              ToolTipService.ShowOnDisabled="True"/>
  </Grid>
</UserControl>
