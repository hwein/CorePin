<UserControl x:Class="CorePin.App.Views.ProcessFlyout"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:CorePin.App.Views"
             Focusable="False">

  <!-- AllowsTransparency keeps the popup window free of system chrome, so no drop shadow;
       the 1 px border below is the flyout's only edge. -->
  <Popup x:Name="FlyoutPopup" StaysOpen="False" Placement="Bottom" AllowsTransparency="True"
         Closed="FlyoutPopup_Closed">
    <!-- Explicit background/foreground: the popup's own HWND does not reliably inherit
         the window theme, so nothing here may rely on inherited colours. -->
    <Border x:Name="FlyoutRoot" Width="280"
            Background="{DynamicResource CorePin.Brush.CardBackground}"
            BorderBrush="{DynamicResource CorePin.Brush.Border}"
            BorderThickness="1"
            TextElement.Foreground="{DynamicResource CorePin.Brush.TextPrimary}"
            KeyboardNavigation.TabNavigation="Cycle"
            KeyboardNavigation.ControlTabNavigation="None"
            PreviewKeyDown="FlyoutRoot_PreviewKeyDown">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="1"/>
          <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBox x:Name="SearchBox" Margin="{StaticResource CorePin.Thickness.4}"
                 MinHeight="{StaticResource CorePin.HitTarget.MinHeight}"
                 VerticalContentAlignment="Center"
                 Background="{DynamicResource CorePin.Brush.WindowBackground}"
                 Foreground="{DynamicResource CorePin.Brush.TextPrimary}"
                 BorderBrush="{DynamicResource CorePin.Brush.Border}"
                 CaretBrush="{DynamicResource CorePin.Brush.TextPrimary}"
                 Loaded="SearchBox_Loaded" TextChanged="SearchBox_TextChanged"/>

        <Border Grid.Row="1" Background="{DynamicResource CorePin.Brush.Border}"/>

        <!-- 224 = seven 32 px rows; the eighth scrolls. -->
        <ListBox x:Name="ProcessList" Grid.Row="2" MaxHeight="224"
                 Background="Transparent" BorderThickness="0" Padding="0"
                 HorizontalContentAlignment="Stretch"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListBox.ItemContainerStyle>
            <!-- Same reason as the rule list: without an own template the classic chrome
                 paints grey-on-grey selection regardless of theme. -->
            <Style TargetType="ListBoxItem">
              <Setter Property="Height" Value="32"/>
              <Setter Property="Padding" Value="0"/>
              <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
              <Setter Property="VerticalContentAlignment" Value="Stretch"/>
              <Setter Property="TextElement.Foreground" Value="{DynamicResource CorePin.Brush.TextPrimary}"/>
              <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
              <Setter Property="Template">
                <Setter.Value>
                  <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="ItemChrome" Background="Transparent"
                            Padding="{TemplateBinding Padding}">
                      <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                    </Border>
                    <ControlTemplate.Triggers>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter TargetName="ItemChrome" Property="Background"
                                Value="{DynamicResource CorePin.Brush.WindowBackground}"/>
                      </Trigger>
                    </ControlTemplate.Triggers>
                  </ControlTemplate>
                </Setter.Value>
              </Setter>
              <EventSetter Event="PreviewMouseLeftButtonDown" Handler="Row_PreviewMouseLeftButtonDown"/>
            </Style>
          </ListBox.ItemContainerStyle>
          <ListBox.ItemTemplate>
            <DataTemplate DataType="{x:Type views:FlyoutProcessRow}">
              <Grid Margin="8,0" Background="Transparent">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto"/>
                  <ColumnDefinition Width="*"/>
                  <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Image Width="20" Height="20" Stretch="Uniform" VerticalAlignment="Center"
                       Source="{Binding Icon, TargetNullValue={StaticResource CorePin.Icon.Placeholder}}"/>
                <TextBlock Grid.Column="1" Text="{Binding ExeName}" Margin="4,0,0,0"
                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Pid}" Margin="8,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource CorePin.Brush.TextSecondary}"/>
              </Grid>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>

        <TextBlock x:Name="EmptyHint" Grid.Row="2" Text="{x:Static views:ProcessFlyout.EmptyText}"
                   Margin="{StaticResource CorePin.Thickness.8}" TextWrapping="Wrap"
                   Visibility="Collapsed"
                   Foreground="{DynamicResource CorePin.Brush.TextSecondary}"/>

        <Border Grid.Row="3" Background="{DynamicResource CorePin.Brush.Border}"/>

        <TextBlock Grid.Row="4" Text="Tip: pick the game itself, not its launcher."
                   Margin="8,4" TextWrapping="Wrap"
                   Foreground="{DynamicResource CorePin.Brush.TextSecondary}"/>
      </Grid>
    </Border>
  </Popup>
</UserControl>
