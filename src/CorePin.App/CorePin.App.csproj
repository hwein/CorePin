<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>CorePin</AssemblyName>
    <RootNamespace>CorePin.App</RootNamespace>
    <StartupObject>CorePin.App.Program</StartupObject>
    <ApplicationIcon>..\..\assets\CorePin.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- SelfContained etc. belong in build/publish.cmd; here they make restore go online -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- DELIBERATELY NOT SET: IncludeNativeLibrariesForSelfExtract, InvariantGlobalization -->
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CorePin.Core\CorePin.Core.csproj" />
    <ProjectReference Include="..\CorePin.Interop\CorePin.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\tray-light.ico" Link="Assets\tray-light.ico" />
    <EmbeddedResource Include="..\..\assets\tray-dark.ico"  Link="Assets\tray-dark.ico" />
  </ItemGroup>

  <!-- Without this switch Fluent puts a Mica backdrop on every window by itself. -->
  <ItemGroup>
    <RuntimeHostConfigurationOption
        Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop"
        Value="true" />
  </ItemGroup>

  <!-- Fails when icon.svg's content no longer matches the .ico files exported from it.
       Content-hash based, not timestamp based: a checkout, switch or stash pop can leave
       icon.svg with a newer mtime than the .ico files without anything being stale. -->
  <Target Name="CorePinIconFreshnessCheck" BeforeTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\assets\icon.svg')">
    <GetFileHash Files="$(MSBuildProjectDirectory)\..\..\assets\icon.svg" Algorithm="SHA256">
      <Output TaskParameter="Items" ItemName="_CorePinSvgHashed" />
    </GetFileHash>
    <PropertyGroup>
      <_CorePinSvgHash>%(_CorePinSvgHashed.FileHash)</_CorePinSvgHash>
      <_CorePinSvgHashSidecar>$(MSBuildProjectDirectory)\..\..\assets\icon.svg.sha256</_CorePinSvgHashSidecar>
    </PropertyGroup>
    <PropertyGroup Condition="Exists('$(_CorePinSvgHashSidecar)')">
      <_CorePinSidecarHash>$([System.IO.File]::ReadAllText('$(_CorePinSvgHashSidecar)').Trim())</_CorePinSidecarHash>
    </PropertyGroup>
    <Error Condition="'$(_CorePinSvgHash.ToUpperInvariant())' != '$(_CorePinSidecarHash.ToUpperInvariant())'"
           Text="assets/icon.svg does not match its exported .ico files — run 'dotnet run --project tools\IconGen'." />
  </Target>
</Project>
