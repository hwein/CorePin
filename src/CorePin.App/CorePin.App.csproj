<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <UseWPF>true</UseWPF>
    <AssemblyName>CorePin</AssemblyName>          <!-- E2: the EXE is named CorePin.exe -->
    <RootNamespace>CorePin.App</RootNamespace>
    <StartupObject>CorePin.App.Program</StartupObject>
    <ApplicationIcon>..\..\assets\CorePin.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <!-- SelfContained / RuntimeIdentifier / PublishSingleFile live in build/publish.cmd: in the
         project file they make even a plain restore pull runtime packs from the network (E1). -->
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <!-- DELIBERATELY NOT SET in v0.1:
         IncludeNativeLibrariesForSelfExtract (S01 §6.2, A16) and
         InvariantGlobalization (S01 §6.2, A16) -->
  </PropertyGroup>
  <ItemGroup>
    <ApplicationDefinition Remove="App.xaml" />
    <Page Include="App.xaml" SubType="Designer" Generator="MSBuild:Compile" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\CorePin.Core\CorePin.Core.csproj" />
    <ProjectReference Include="..\CorePin.Interop\CorePin.Interop.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\assets\tray-light.ico" Link="Assets\tray-light.ico" />
    <EmbeddedResource Include="..\..\assets\tray-dark.ico"  Link="Assets\tray-dark.ico" />
  </ItemGroup>

  <!-- Gate G0 picked path A; 01 §5 rules out Mica, and without this switch Fluent puts a Mica
       backdrop on every window by itself (S03 §3.2/D15). -->
  <ItemGroup>
    <RuntimeHostConfigurationOption
        Include="Switch.System.Windows.Appearance.DisableFluentThemeWindowBackdrop"
        Value="true" />
  </ItemGroup>

  <!-- Icon freshness check (S12 §6.3): fails when icon.svg is newer than one of the three
       .ico derivations. Plain MSBuild, no NuGet dependency. -->
  <Target Name="CorePinIconFreshnessCheck" BeforeTargets="Build"
          Condition="Exists('$(MSBuildProjectDirectory)\..\..\assets\icon.svg')">
    <PropertyGroup>
      <_CorePinSvgTime>$([System.IO.File]::GetLastWriteTime('$(MSBuildProjectDirectory)\..\..\assets\icon.svg').Ticks)</_CorePinSvgTime>
      <_CorePinIcoTime>$([System.IO.File]::GetLastWriteTime('$(MSBuildProjectDirectory)\..\..\assets\CorePin.ico').Ticks)</_CorePinIcoTime>
      <_TrayLightIcoTime>$([System.IO.File]::GetLastWriteTime('$(MSBuildProjectDirectory)\..\..\assets\tray-light.ico').Ticks)</_TrayLightIcoTime>
      <_TrayDarkIcoTime>$([System.IO.File]::GetLastWriteTime('$(MSBuildProjectDirectory)\..\..\assets\tray-dark.ico').Ticks)</_TrayDarkIcoTime>
    </PropertyGroup>
    <Error Condition="$(_CorePinSvgTime) &gt; $(_CorePinIcoTime)"
           Text="assets/icon.svg is newer than assets/CorePin.ico — re-export the icons (S12 §6.2)." />
    <Error Condition="$(_CorePinSvgTime) &gt; $(_TrayLightIcoTime)"
           Text="assets/icon.svg is newer than assets/tray-light.ico — re-export the icons (S12 §6.2)." />
    <Error Condition="$(_CorePinSvgTime) &gt; $(_TrayDarkIcoTime)"
           Text="assets/icon.svg is newer than assets/tray-dark.ico — re-export the icons (S12 §6.2)." />
  </Target>
</Project>
