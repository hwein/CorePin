# ─────────────────────────────────────────────────────────────────────────────
# Planungsdaten — bleiben lokal, das Repo geht öffentlich
# ─────────────────────────────────────────────────────────────────────────────
# Konzept- und Spec-Dokumente sind interne Arbeitsunterlagen (deutsch) und
# gehören nicht in ein öffentliches Repository. Sie liegen bewusst im
# Arbeitsverzeichnis, damit die Werkzeugkette sie findet — aber nie im Git.
concepts/
specs/

# Werkzeugkonfiguration der Arbeitsumgebung — lokal, nicht Teil des Projekts.
.claude/

