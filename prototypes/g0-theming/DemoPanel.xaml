<UserControl x:Class="G0Theming.DemoPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource CorePin.Font.UI}"
             FontSize="{StaticResource CorePin.FontSize.UI}">

  <!-- 8 DIP of pure window background all around: the pixel probes of measurement 2 sample
       that ring, so no control may reach into it. -->
  <Grid Margin="{StaticResource CorePin.Thickness.8}">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="220"/>
      <ColumnDefinition Width="8"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3"
                Orientation="Horizontal" Margin="0,0,0,8">
      <TextBox x:Name="SearchBox" Width="130" Height="28" VerticalContentAlignment="Center"
               Text="notepad" Padding="6,0,6,0"/>
      <Button x:Name="PresetButton" Content="CCD 0" Height="28" MinWidth="64"
              Margin="8,0,0,0"/>
      <CheckBox x:Name="SmtToggle" Content="SMT threads" IsChecked="True"
                VerticalAlignment="Center" Margin="8,0,0,0"/>
      <Button x:Name="PopupButton" Content="From running…" Height="28" MinWidth="96"
              Margin="8,0,0,0" Click="OnTogglePopup"/>
      <Button x:Name="ThemeButton" Content="Toggle theme" Height="28" MinWidth="96"
              Margin="8,0,0,0" Click="OnToggleTheme"/>
      <Popup x:Name="Flyout" Placement="Bottom" StaysOpen="True"
             AllowsTransparency="False" PopupAnimation="None">
        <!-- 01 §2: separators instead of shadows — border, no drop shadow (S03 §9). -->
        <Border x:Name="FlyoutSurface" BorderThickness="1"
                BorderBrush="{DynamicResource CorePin.Brush.Border}"
                Background="{DynamicResource CorePin.Brush.CardBackground}"
                Padding="{StaticResource CorePin.Thickness.8}">
          <StackPanel>
            <TextBlock Text="chrome.exe"/>
            <TextBlock Text="devenv.exe" Margin="0,4,0,0"/>
            <TextBlock Text="cyberpunk2077.exe" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </Popup>
    </StackPanel>

    <ListBox x:Name="RuleList" Grid.Row="1" Grid.Column="0"
             HorizontalContentAlignment="Stretch"
             ScrollViewer.VerticalScrollBarVisibility="Auto"
             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
             BorderThickness="1"
             BorderBrush="{DynamicResource CorePin.Brush.Border}"
             Background="{DynamicResource CorePin.Brush.CardBackground}"/>

    <Grid Grid.Row="1" Grid.Column="2">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,8">
        <CheckBox x:Name="ClusterCheck" IsThreeState="True" IsChecked="{x:Null}"
                  VerticalAlignment="Center"/>
        <TextBlock Text="CCD 0 · 8C/16T · 32 MB L3" Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="{StaticResource CorePin.Font.Mono}"
                   FontSize="{StaticResource CorePin.FontSize.Mono}"/>
      </StackPanel>

      <ScrollViewer x:Name="CardScroller" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                    HorizontalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="CellHost">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal"/>
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
        </ItemsControl>
      </ScrollViewer>
    </Grid>

    <!-- Watch mode only; Collapsed costs no layout in the capture runs. -->
    <TextBlock x:Name="WatchStatus" Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3"
               Visibility="Collapsed" Margin="0,8,0,0" TextWrapping="Wrap"
               FontFamily="{StaticResource CorePin.Font.Mono}"
               FontSize="{StaticResource CorePin.FontSize.Mono}"
               Foreground="{DynamicResource CorePin.Brush.TextSecondary}"/>
  </Grid>
</UserControl>
