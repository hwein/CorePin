<local:AppBase x:Class="G0Theming.FluentApp"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="clr-namespace:G0Theming"
               ThemeMode="System">
  <!-- Weg A in the shape CorePin would actually build: ThemeMode on the Application, declared
       in XAML, never touched in code (S03 D18). -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.xaml"/>
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</local:AppBase>
