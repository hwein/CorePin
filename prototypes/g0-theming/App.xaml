<local:AppBase x:Class="G0Theming.App"
               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
               xmlns:local="clr-namespace:G0Theming">
  <!-- No ThemeMode here: used by Weg B and by the two window-level Weg-A variants. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="Themes/Tokens.xaml"/>
        <!-- No third static entry: the theme slot is merged at runtime by
             ThemeController.Initialize and only ever filled through the held instance. -->
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>
</local:AppBase>
