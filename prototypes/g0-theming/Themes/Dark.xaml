<!-- Copy of S03 §4.5 (dark) for the throw-away G0 prototype. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="CorePin.Color.WindowBackground">#1C1C1C</Color>
  <Color x:Key="CorePin.Color.CardBackground">#252525</Color>
  <Color x:Key="CorePin.Color.TextPrimary">#F2F2F2</Color>
  <Color x:Key="CorePin.Color.TextSecondary">#A0A0A0</Color>
  <Color x:Key="CorePin.Color.Border">#3A3A3A</Color>

  <SolidColorBrush x:Key="CorePin.Brush.WindowBackground" Color="{StaticResource CorePin.Color.WindowBackground}"/>
  <SolidColorBrush x:Key="CorePin.Brush.CardBackground"   Color="{StaticResource CorePin.Color.CardBackground}"/>
  <SolidColorBrush x:Key="CorePin.Brush.TextPrimary"      Color="{StaticResource CorePin.Color.TextPrimary}"/>
  <SolidColorBrush x:Key="CorePin.Brush.TextSecondary"    Color="{StaticResource CorePin.Color.TextSecondary}"/>
  <SolidColorBrush x:Key="CorePin.Brush.Border"           Color="{StaticResource CorePin.Color.Border}"/>
</ResourceDictionary>
